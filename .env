# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.

# --- Web ---------------------------------------------------------------------
# URL pÃºblica sin barra final (canonical, sitemap, Stripe, correos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Base de datos (PostgreSQL) ----------------------------------------------
# Local (npm run db:local):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/bm_mobils
# Supabase: Project Settings > Database > Connection string (modo "Session" o "Transaction" con ?pgbouncer=true)

# --- Sesiones ------------------------------------------------------------------
# Cadena aleatoria larga (p. ej. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
SESSION_SECRET=926a597ec468a842fac947a35d1e24bc01bf46001778fc14d69549f136f1c9be

# --- Stripe (https://dashboard.stripe.com/test/apikeys) -----------------------
# Usa claves de prueba (sk_test_...) hasta validar todo el flujo.
STRIPE_SECRET_KEY=
# Secreto del endpoint de webhook (whsec_...). En local lo da `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# --- Almacenamiento de imÃ¡genes -----------------------------------------------
# local: guarda en public/uploads (solo desarrollo o servidores con disco persistente)
# supabase: Supabase Storage (recomendado en producciÃ³n)
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# --- Correo transaccional (Resend: https://resend.com) ------------------------
# Sin clave, los correos se escriben en la consola del servidor.
RESEND_API_KEY=
EMAIL_FROM="BM Mobils <pedidos@tudominio.es>"

# --- Tareas programadas --------------------------------------------------------
# Protege /api/cron/release-reservations (libera stock de pagos no completados)
CRON_SECRET=
